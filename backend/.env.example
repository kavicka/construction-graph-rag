# Copy to backend/.env and uncomment what you want to change. Every line shows the default.
# Sources: backend/app/config.py, backend/app/security.py, backend/app/workforce/config.py.
# Never commit backend/.env: it can hold an API key and the admin password.

# --- Models and retrieval ---------------------------------------------------------------
# RAG_DATA_DIR=<repo>/data                 # PDFs, parsed files, LanceDB, app.db, generated PDFs
# RAG_LLM_PROVIDER=ollama                  # ollama | openai (any OpenAI-compatible API)
# RAG_OLLAMA_BASE_URL=http://localhost:11434
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=
# RAG_ANSWER_MODEL=qwen3:4b-instruct
# RAG_EXTRACT_MODEL=qwen3:1.7b
# RAG_RAM_PROFILE=auto                     # auto | low | high (high = 32 GB or more)
# RAG_EMBEDDING_MODEL=                     # empty = by profile (low: multilingual-e5-small, high: bge-m3)
# RAG_RERANK=                              # empty = on for the high profile only
# RAG_RERANKER_MODEL=                      # empty = by profile
# RAG_CHUNK_MAX_TOKENS=450
# RAG_CONTEXTUAL_CHUNKS=true               # LLM context line per chunk at ingest
# RAG_GRAPH_EXPANSION=true
# RAG_GRAPH_WEIGHT=1.0                     # weight of graph candidates in RRF fusion
# RAG_GRAPH_RELATIONAL_ONLY=true           # graph candidates only for relational questions
# RAG_AGENT_MODE=true                      # agent loop with tools for compositional questions
# RAG_VISUAL_RETRIEVAL=false               # experimental ColPali pages (uv sync --extra visual)
# RAG_VISUAL_MODEL=vidore/colSmol-256M

# --- Auth and security ------------------------------------------------------------------
# RAG_AUTH_ENABLED=false                   # login, groups, per-document access
# RAG_ADMIN_EMAIL=                         # first admin, created at startup if no user exists
# RAG_ADMIN_PASSWORD=
# RAG_SESSION_TTL_HOURS=168
# RAG_COOKIE_SECURE=false                  # true behind an HTTPS proxy
# RAG_API_TOKEN_TTL_DAYS=90                # lifetime of Bearer API tokens
# RAG_LOGIN_MAX_FAILURES=10                # failed password/PIN logins per client IP ...
# RAG_LOGIN_WINDOW_MINUTES=15              # ... within this window, then HTTP 429
# RAG_TRUSTED_PROXY=false                  # read the client IP from X-Forwarded-For (own proxy only)
# RAG_INJECTION_GUARD=true                 # defences against instructions hidden in documents
# RAG_SCOPE_GUARD=true                     # secrets, internals, off-purpose questions get a fixed answer
# RAG_SCOPE_CLASSIFIER=true                # small LLM decides the scope when the library gives no signal
# RAG_MCP_ALLOWED_HOSTS=                   # extra Host headers for /mcp, e.g. "backend:*,rag.lan:*"

# --- Company module (Firma) -------------------------------------------------------------
# RAG_STT_MODEL=                           # empty = mlx-community/whisper-large-v3-turbo (Apple Silicon)
# RAG_TTS_VOICE=sk_SK-lili-medium          # Piper voice, downloaded into data/voices
# RAG_WORKFORCE_MODEL=                     # report/task extraction; empty = qwen3:4b-instruct (low), qwen3:30b-a3b-instruct-2507-q4_K_M (high)
# RAG_PIN_MAX_ATTEMPTS=5                   # wrong PINs before a worker is locked
# RAG_PIN_LOCK_MINUTES=15
# RAG_WORKER_SESSION_DAYS=90               # workers stay logged in on their phone
# RAG_HOURS_TOLERANCE=0.5                  # allowed gap (hours) between worked time and task hours
# RAG_DAILY_SUMMARY=true                   # automatic daily summary report
# RAG_DAILY_SUMMARY_TIME=19:00
# RAG_AUDIO_RETENTION_DAYS=30

# --- Operations -------------------------------------------------------------------------
# RAG_INBOX_SYNC=true                      # watch data/inbox
# RAG_INBOX_INTERVAL_S=5.0
# RAG_TRACING=true                         # OpenTelemetry spans into SQLite (built-in viewer)
# RAG_OTLP_ENDPOINT=                       # e.g. http://localhost:6006/v1/traces (Phoenix)
# RAG_OTLP_HEADERS=                        # "Authorization=Basic xyz,X-Other=1" (Langfuse)
